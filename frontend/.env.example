# Local development needs no frontend .env. Leave backend/.env unchanged.
# For a staging build, copy these settings to frontend/.env.staging locally,
# or set them as build environment variables. Every VITE_* value is public.
VITE_PDW_RUNTIME=staging
VITE_PDW_BASE_PATH=/purchase-decision-workspace/
VITE_PDW_API_ORIGIN=https://REPLACE-WITH-ASSIGNED-API.onrender.com
VITE_PDW_AUTH0_DOMAIN=REPLACE-WITH-TENANT.auth0.com
VITE_PDW_AUTH0_CLIENT_ID=REPLACE-WITH-PUBLIC-SPA-CLIENT-ID
VITE_PDW_AUTH0_AUDIENCE=https://purchase-decision-workspace-staging-api
