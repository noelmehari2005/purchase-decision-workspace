# Copy to backend/.env, which is ignored by Git. Never paste secrets in chat.
PDW_LOCAL_STORAGE=1
PDW_AUTH_MODE=auth0
PDW_MONGO_URI=mongodb://127.0.0.1:27017
PDW_MONGO_DATABASE=purchase_decision_workspace
PDW_APP_ORIGIN=http://127.0.0.1:5173
PDW_AUTH0_DOMAIN=
PDW_AUTH0_CLIENT_ID=
PDW_AUTH0_CLIENT_SECRET=
PDW_AUTH0_CONNECTION=Username-Password-Authentication
# Separate Machine-to-Machine app: Auth0 Management API, read:users only.
PDW_AUTH0_MANAGEMENT_CLIENT_ID=
PDW_AUTH0_MANAGEMENT_CLIENT_SECRET=

# Open Icecat: either your channel-partner username or a server-side API token.
# No paid Full Icecat subscription is required for covered Open Icecat products.
PDW_ICECAT_USERNAME=
PDW_ICECAT_API_TOKEN=

# Transactional deletion notifications: TLS required, 465=implicit TLS, others=STARTTLS.
PDW_SMTP_HOST=
PDW_SMTP_PORT=465
PDW_SMTP_FROM=
PDW_SMTP_USERNAME=
PDW_SMTP_PASSWORD=
# Separate M2M application with delete:users only; keep read:users app unchanged.
PDW_AUTH0_DELETION_CLIENT_ID=
PDW_AUTH0_DELETION_CLIENT_SECRET=

# Hosted scheduler only. Leave disabled until a reviewed check-only deployment.
PDW_MAINTENANCE_ENABLED=0
PDW_MAINTENANCE_MODE=check
## Optional one-attempt hosted email test; enable email-test mode explicitly.
PDW_EMAIL_TEST_TO=
PDW_EMAIL_TEST_ID=
# Generate privately: python3 -c 'import secrets; print(secrets.token_hex(32))'
PDW_MAINTENANCE_SECRET=
